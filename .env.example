# Anthropic
ANTHROPIC_API_KEY=your-api-key-here

# GitHub
GITHUB_REPO=https://github.com/Sinnup/hypertech.git
GITHUB_TOKEN=your-github-token-here

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# Slack
SLACK_BOT_TOKEN=your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
SLACK_WEBHOOK_URL=your-slack-webhook-url-here
SLACK_CHANNEL_STATUS=agent-status
SLACK_CHANNEL_APPROVALS=human-approvals
SLACK_CHANNEL_DEPLOYMENTS=deployments
SLACK_CHANNEL_SECURITY=security-alerts

# ngrok
NGROK_AUTHTOKEN=your-ngrok-authtoken-here

# Langfuse (local Docker)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here

# ChromaDB (local Docker)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# AWS (cert/prod only — leave empty for local dev)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
